# .gitignore for EarningsEdge AI
# Keep sensitive files and large data files out of version control

# Environment & secrets
.env
*.env

# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
.eggs/

# Testing and coverage
.pytest_cache/
htmlcov/
.coverage
.tox/

# Virtual environments
earningsedge_env/
venv/
env/
.venv/

# Data files (too large for git — use DVC or cloud storage)
data/raw/
data/processed/
data/prices/
data/labels/
data/lexicon/lm_lexicon.pkl
*.csv
*.parquet
# Ignored due to large sizes usually, keep configs
# *.json 

# Model checkpoints (use git-lfs or model registry for these)
models/finbert/
models/hedge_ner/
*.pt
*.pth
*.h5
*.bin
*.onnx

# Signals and metrics output
signals/
# To ignore items in metrics but keep the directory tracked:
# metrics/*
# !metrics/backtest_results.json
metrics/

# Logs
logs/
*.log

# Jupyter notebooks outputs
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
