# EarningsEdge AI — Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ─── Alpaca Markets API ────────────────────────────────────────────────────────
# Get free keys at: https://app.alpaca.markets/signup
# Paper trading keys work for all historical data needs
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# ─── Optional: OpenAI API (for LLM-augmented hedge extraction in Phase 2) ─────
# OPENAI_API_KEY=your_openai_key_here

# ─── EarningsEdge API Key (used by the FastAPI server) ─────────────────────────
EARNINGSEDGE_API_KEY=dev-secret-key-change-in-production
